{
  "permissions": {
    "allow": [
      "Bash(plutil -extract CFBundleDocumentTypes json -o - '/Applications/Arturia/MIDI Control Center.app/Contents/Info.plist')",
      "Bash(plutil -extract CFBundleShortVersionString raw -o - '/Applications/Arturia/MIDI Control Center.app/Contents/Info.plist')",
      "Read(//Applications/Arturia/MIDI Control Center.app/Contents/Resources/**)",
      "Bash(uv sync *)",
      "Bash(uv run *)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "allowedTools": [
    "python -m compileall -q .",
    "mypy ."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/guard_rails.sh\"",
            "description": "Block dangerous shell operations before they execute"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/validate.sh\" --hook",
            "description": "Verify code compilation, type safety, and test criteria before completing turn"
          }
        ]
      }
    ]
  }
}
